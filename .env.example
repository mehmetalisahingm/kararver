# ─────────────────────────────────────────────────────────────
# KararVer — LOCAL geliştirme ortamı
# Kullanım:  cp .env.example .env
# Buradaki tüm değerler docker-compose.yml'deki local container'lara
# aittir; gerçek bir gizli değer DEĞİLDİR. Staging değerleri için
# .env.staging.example'a bakın (değerler orada boş bırakılır).
# ─────────────────────────────────────────────────────────────

# Ortam: local | staging | production
APP_ENV=local
NODE_ENV=development
APP_TIMEZONE=Europe/Istanbul
LOG_LEVEL=debug

# Adresler
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (docker compose → postgres)
DATABASE_URL=postgresql://kararver:kararver_local@localhost:5432/kararver?schema=public
# API/worker PostgreSQL testleri (KV-06). Test harness'i .env OKUMAZ: bu değeri
# terminalde set/export edin (docs/KV-06_LOCAL_SETUP.md). Adı _test ile bitmeli.
# TEST_DATABASE_URL=postgresql://kararver:kararver_local@localhost:5432/kararver_test

# Oturum (DB'de tutulan opak token + httpOnly cookie)
SESSION_COOKIE_NAME=kv_session
# Local'de boş bırakın (host-only cookie). Staging/prod: .kararver.com gibi
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
# KV-19 hız sınırı (docs/KV-19_RATE_LIMIT.md). Yalnız local/test'te false olabilir (ör. yük testi).
RATE_LIMIT_ENABLED=true
SESSION_TTL_DAYS=30
# Token hash'lerine eklenen pepper. Local için herhangi bir uzun rastgele değer:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN_PEPPER=

# E-posta (doğrulama / şifre sıfırlama)
# local: console → mailler API loguna yazılır
# smtp: SMTP_URL zorunlu (ör. Mailpit: smtp://localhost:1025?ignoreTLS=true)
MAIL_TRANSPORT=console
MAIL_FROM="KararVer <no-reply@localhost>"
SMTP_URL=

# Object storage (docker compose → seaweedfs, S3 uyumlu)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=kararver-local
S3_SECRET_ACCESS_KEY=kararver-local-only-not-a-secret
# Karantina (private) ve onaylanmış (public) görseller
S3_BUCKET_PRIVATE=kararver-uploads-private
S3_BUCKET_PUBLIC=kararver-media-public
# Bucket-scoped credentials (e.g. Railway); both fields must be set together.
# S3_PUBLIC_ACCESS_KEY_ID=
# S3_PUBLIC_SECRET_ACCESS_KEY=
# Private-only storage: MEDIA_PUBLIC_BASE_URL=<WEB_URL>/api/media-public
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/kararver-media-public

# Background job'lar (pg-boss, aynı PostgreSQL'i kullanır)
JOBS_ENABLED=true
# Optional encrypted backups on the existing worker (no additional service).
# Disabled until separate write-only bucket, public key custody and restore acceptance are ready.
BACKUP_ENABLED=false
# BACKUP_PUBLIC_KEY=<RSA public PEM only; never the private key>
# BACKUP_S3_ENDPOINT=https://<approved-s3-endpoint>
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=<separate-backup-bucket>
# BACKUP_S3_ACCESS_KEY_ID=<write-only credential>
# BACKUP_S3_SECRET_ACCESS_KEY=<write-only credential>
# BACKUP_DESTINATION=s3
# BACKUP_PREFIX=db/staging
# PG_BIN=<matching-server-major-client-bin>
# Görsel moderasyonu (apps/worker, docs/MEDIA_MODERATION.md §4). Yorumlayıcıda
# apps/worker/python/requirements.txt kurulu olmalı. Eşzamanlı işlenen görsel sayısı:
MODERATION_PYTHON=python
MEDIA_WORKER_CONCURRENCY=1
TREND_REFRESH_CRON="*/5 * * * *"
DAILY_SNAPSHOT_CRON="5 0 * * *"
