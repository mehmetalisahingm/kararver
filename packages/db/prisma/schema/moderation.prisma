// Sahip: Mert (@MertKAYAR) — KV-24
// Kullanıcı raporları ve moderasyon işlem geçmişi.
// Kurallar: docs/DATA_MODEL.md §9 · Yetki matrisi: docs/FOUNDATION_CONTRACTS.md
//
// Hedef, tek bir target_type/target_id çifti yerine hedef başına ayrı nullable FK ile
// tutulur; "tam olarak biri dolu" CHECK'i migration'da elle yazılıdır. Karar güncellemesi
// (Mehmet, KV-23) tablosu açılınca aynı yöntemle yeni bir FK eklenir.

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  HATE
  PERSONAL_INFO
  MISLEADING
  COPYRIGHT
  OTHER

  @@map("report_reason")
}

// OPEN → ACTIONED (içeriğe işlem uygulandı) | DISMISSED (işlem gerekmedi)
enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED

  @@map("report_status")
}

// API'deki ModerationAction (KV-03) + medya kararı (APPROVE/REJECT) + DB'ye özel kayıtlar.
enum ModerationActionType {
  APPROVE
  REJECT
  HIDE
  REMOVE
  RESTORE
  LOCK
  UNLOCK
  EXCLUDE_FROM_TRENDS
  INCLUDE_IN_TRENDS
  WARN_USER
  DISMISS_REPORT
  // KV-37: yalnız yorumları kapatma/açma, kategori-topluluk taşıma, rapor bağlantılı yaptırım.
  CLOSE_COMMENTS
  OPEN_COMMENTS
  MOVE
  SANCTION_USER

  @@map("moderation_action_type")
}

// Rapor içeriği doğrudan silmez; kuyruğa düşer (MVP_PLAN §13).
// Kullanıcı başına hedef başına tek satır (unique'ler). Açık rapor varken tekrar istek
// aynı satırı döndürür; kapanmış raporun sahibi yeniden raporlarsa aynı satır OPEN'a
// döner (önceki karar moderation_actions'ta kalır). Kural: reports.create sözleşmesi.
model Report {
  id             String       @id @default(uuid(7)) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  pollId         String?      @map("poll_id") @db.Uuid
  commentId      String?      @map("comment_id") @db.Uuid
  mediaId        String?      @map("media_id") @db.Uuid
  reportedUserId String?      @map("reported_user_id") @db.Uuid
  reason         ReportReason
  details        String?      @db.VarChar(1000)
  status         ReportStatus @default(OPEN)
  // Sonuçlandıran moderatör; üçü birlikte dolar (CHECK).
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)
  resolutionNote String?      @map("resolution_note") @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter     User               @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  poll         Poll?              @relation(fields: [pollId], references: [id], onDelete: Restrict)
  comment      Comment?           @relation(fields: [commentId], references: [id], onDelete: Restrict)
  media        MediaAsset?        @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  reportedUser User?              @relation("ReportTargetUser", fields: [reportedUserId], references: [id], onDelete: Restrict)
  resolvedBy   User?              @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  actions      ModerationAction[]

  @@unique([reporterId, pollId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, mediaId])
  @@unique([reporterId, reportedUserId])
  // Kuyruk ve "rapor sayısı" filtreleri.
  @@index([status, createdAt])
  @@index([pollId])
  @@index([commentId])
  @@index([mediaId])
  @@index([reportedUserId])
  @@map("reports")
}

// Append-only moderasyon geçmişi (UPDATE/DELETE trigger ile engellenir).
// Yaptırımlar (ban/suspend) Utku'nun sanctions tablosundadır; burada sadece içerik işlemleri
// ve kullanıcı uyarısı tutulur. Kritik işlemler ayrıca audit_logs'a yazılır (KV-39).
model ModerationAction {
  id           String               @id @default(uuid(7)) @db.Uuid
  actorId      String               @map("actor_id") @db.Uuid
  action       ModerationActionType
  pollId       String?              @map("poll_id") @db.Uuid
  commentId    String?              @map("comment_id") @db.Uuid
  mediaId      String?              @map("media_id") @db.Uuid
  targetUserId String?              @map("target_user_id") @db.Uuid
  // Rapora yanıt olarak yapıldıysa.
  reportId     String?              @map("report_id") @db.Uuid
  // content_status veya media_status değeri; iki enum farklı olduğu için metin.
  fromStatus   String?              @map("from_status") @db.VarChar(20)
  toStatus     String?              @map("to_status") @db.VarChar(20)
  reason       String               @db.VarChar(1000)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  // #183: dolu ise bu satır başka bir kararın telafisidir (geri alma); bir karar en çok bir kez geri alınır (UNIQUE). Geri alınan satır değişmez.
  undoOfId     String?              @unique @map("undo_of_id") @db.Uuid

  undoOf     ModerationAction? @relation("ModerationActionUndo", fields: [undoOfId], references: [id], onDelete: Restrict)
  undoneBy   ModerationAction? @relation("ModerationActionUndo")
  actor      User        @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  poll       Poll?       @relation(fields: [pollId], references: [id], onDelete: Restrict)
  comment    Comment?    @relation(fields: [commentId], references: [id], onDelete: Restrict)
  media      MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  targetUser User?       @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  report     Report?     @relation(fields: [reportId], references: [id], onDelete: Restrict)
  batchItems ModerationBatchItem[]

  @@index([pollId, createdAt])
  @@index([commentId, createdAt])
  @@index([mediaId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([reportId])
  @@map("moderation_actions")
}

// #181: kullanıcıya ait içeriğin toplu gizlenmesi/kaldırılması (ve geri alınması). Önizleme → gerekçe → ayrı onay → kuyruk;
// iş API sürecindeki çalıştırıcıda (modules/content-jobs/runner.ts) öğe öğe mevcut moderasyon uygulamasıyla işlenir. Hesap
// başına en çok bir açık iş migration'daki kısmi unique index'le sağlanır (content_jobs_one_open_per_user_key).
enum ContentJobKind {
  HIDE
  REMOVE
  UNDO

  @@map("content_job_kind")
}

enum ContentJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
  CANCELLED

  @@map("content_job_status")
}

enum ContentJobItemResult {
  APPLIED
  UNCHANGED
  FAILED
  SKIPPED

  @@map("content_job_item_result")
}

model ContentJob {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  requestedById   String           @map("requested_by_id") @db.Uuid
  kind            ContentJobKind
  status          ContentJobStatus @default(QUEUED)
  reason          String           @db.VarChar(500)
  includePolls    Boolean          @map("include_polls")
  includeComments Boolean          @map("include_comments")
  cutoffAt        DateTime         @map("cutoff_at") @db.Timestamptz(3)
  expectedPolls    Int             @default(0) @map("expected_polls")
  expectedComments Int             @default(0) @map("expected_comments")
  undoOfId        String?          @unique @map("undo_of_id") @db.Uuid
  applied         Int              @default(0)
  unchanged       Int              @default(0)
  failed          Int              @default(0)
  skipped         Int              @default(0)
  failure         String?          @db.VarChar(60)
  claimedAt       DateTime?        @map("claimed_at") @db.Timestamptz(3)
  startedAt       DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation("ContentJobSubject", fields: [userId], references: [id], onDelete: Restrict)
  requestedBy User             @relation("ContentJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  undoOf      ContentJob?      @relation("ContentJobUndo", fields: [undoOfId], references: [id], onDelete: Restrict)
  undoneBy    ContentJob?      @relation("ContentJobUndo")
  items       ContentJobItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("content_jobs")
}

model ContentJobItem {
  jobId      String               @map("job_id") @db.Uuid
  targetType String               @map("target_type") @db.VarChar(10)
  targetId   String               @map("target_id") @db.Uuid
  fromStatus String?              @map("from_status") @db.VarChar(20)
  toStatus   String?              @map("to_status") @db.VarChar(20)
  result     ContentJobItemResult
  detail     String?              @db.VarChar(60)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  job ContentJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@id([jobId, targetType, targetId])
  @@map("content_job_items")
}

// #183 toplu moderasyon (KV-37 §bulk): seçilen anket/yorumlara tek gerekçeyle HIDE/REMOVE/RESTORE. Parti kaydı, işlemin
// özeti ve geri alma (sonraki dilim) için tek kaynaktır; içerik başına gerçek karar `moderation_actions` + audit + olayda kalır.
enum ModerationBatchKind {
  POLLS
  COMMENTS

  @@map("moderation_batch_kind")
}

enum ModerationBatchItemResult {
  APPLIED
  UNCHANGED
  FAILED

  @@map("moderation_batch_item_result")
}

model ModerationBatch {
  id         String              @id @default(uuid(7)) @db.Uuid
  actorId    String              @map("actor_id") @db.Uuid
  kind       ModerationBatchKind
  action     ModerationActionType
  reason     String              @db.VarChar(500)
  // Önizlemedeki (id, durum, topluluk) listesinin özeti: onay anında yeniden hesaplanır, farklıysa parti açılmaz.
  digest     String              @db.Char(64)
  // X-Request-Id: bu partinin bütün audit kayıtlarını bağlar.
  requestId  String?             @map("request_id") @db.Uuid
  // Dolu ise bu parti başka bir partinin geri almasıdır (telafi kararları); geri almanın geri alması yoktur.
  undoOfId   String?             @map("undo_of_id") @db.Uuid
  total      Int
  // Parti açılırken rezerve edilen değişecek kayıt sayısı; bitmemiş partinin ikinci onay penceresindeki ağırlığı (bitince applied).
  reserved   Int                 @default(0)
  applied    Int                 @default(0)
  unchanged  Int                 @default(0)
  failed     Int                 @default(0)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt DateTime?           @map("finished_at") @db.Timestamptz(3)

  actor User                 @relation("ModerationBatchActor", fields: [actorId], references: [id], onDelete: Restrict)
  items ModerationBatchItem[]
  undoOf     ModerationBatch?  @relation("ModerationBatchUndo", fields: [undoOfId], references: [id], onDelete: Restrict)
  undoneBy   ModerationBatch[] @relation("ModerationBatchUndo")
  undoneItems ModerationBatchItem[] @relation("ModerationBatchItemUndone")
  approval   ModerationBulkApproval? @relation("BulkApprovalBatch")

  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("moderation_batches")
}

// #183 yüksek hacimli toplu işlem için ikinci onay talebi. Talep içeriği değiştirmez; başlatandan farklı bir ADMIN+ MFA ile onaylayınca
// parti (batchId) başlatan adına uygulanır. Süresi dolan talep PENDING kalır, okunurken EXPIRED sayılır. CHECK'ler migration'dadır.
model ModerationBulkApproval {
  id             String               @id @default(uuid(7)) @db.Uuid
  kind           ModerationBatchKind
  action         ModerationActionType
  reason         String               @db.VarChar(500)
  digest         String               @db.Char(64)
  ids            String[]             @db.Uuid
  willChange     Int                  @map("will_change")
  needsAdmin     Boolean              @map("needs_admin")
  communityIds   String[]             @default([]) @map("community_ids") @db.Uuid
  initiatorId    String               @map("initiator_id") @db.Uuid
  status         String               @default("PENDING") @db.VarChar(20)
  requestId      String?              @map("request_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  decidedById    String?              @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?            @map("decided_at") @db.Timestamptz(3)
  decisionReason String?              @map("decision_reason") @db.VarChar(500)
  batchId        String?              @unique @map("batch_id") @db.Uuid

  initiator User             @relation("BulkApprovalInitiator", fields: [initiatorId], references: [id], onDelete: Restrict)
  decidedBy User?            @relation("BulkApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  batch     ModerationBatch? @relation("BulkApprovalBatch", fields: [batchId], references: [id], onDelete: Restrict)

  @@index([initiatorId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("moderation_bulk_approvals")
}

model ModerationBatchItem {
  batchId           String                    @map("batch_id") @db.Uuid
  targetId          String                    @map("target_id") @db.Uuid
  communityId       String?                   @map("community_id") @db.Uuid
  result            ModerationBatchItemResult
  // Başarısızlık nedeni (not_found, forbidden, invalid_transition, removed, ...); başarıda boş.
  detail            String?                   @db.VarChar(40)
  fromStatus        String?                   @map("from_status") @db.VarChar(20)
  toStatus          String?                   @map("to_status") @db.VarChar(20)
  // Uygulanan kararın kaydı (geri alma bunu hedef alır); uygulanmadıysa boş.
  moderationActionId String?                  @map("moderation_action_id") @db.Uuid
  // Bu öğenin kararını geri alan partinin kimliği; yalnız geri alma başarıyla uygulandığında yazılır (öğe başına en çok bir geri alma).
  undoneByBatchId   String?                   @map("undone_by_batch_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  batch            ModerationBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  moderationAction ModerationAction? @relation(fields: [moderationActionId], references: [id], onDelete: Restrict)
  undoneByBatch    ModerationBatch?  @relation("ModerationBatchItemUndone", fields: [undoneByBatchId], references: [id], onDelete: Restrict)

  @@id([batchId, targetId])
  @@index([undoneByBatchId])
  @@index([targetId, createdAt])
  @@map("moderation_batch_items")
}
