// Sahip: Mert (@MertKAYAR) — KV-31
// Admin kontrollü topluluklar ve üyelik. Topluluk rolü istemci iddiasından değil,
// bu tablodaki üyelikten okunur (FOUNDATION_CONTRACTS yetki matrisi).
// Kurallar: docs/DATA_MODEL.md §9
//
// Durum content_status'tur: ACTIVE normal, LOCKED kapatılmış (görünür ama yeni üyelik
// ve içerik yok), HIDDEN / REMOVED moderasyon. Kapatılan topluluğun anketleri silinmez.

enum CommunityRole {
  MEMBER
  MODERATOR

  @@map("community_role")
}

model Community {
  id           String        @id @default(uuid(7)) @db.Uuid
  slug         String        @unique @db.VarChar(60)
  name         String        @db.VarChar(80)
  description  String?       @db.VarChar(1000)
  imageMediaId String?       @map("image_media_id") @db.Uuid
  status       ContentStatus @default(ACTIVE)
  // Denormalize sayaç; üyelikle aynı transaction'da güncellenir (DATA_MODEL §2.5).
  memberCount  Int           @default(0) @map("member_count")
  createdById  String        @map("created_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  imageMedia  MediaAsset?           @relation(fields: [imageMediaId], references: [id], onDelete: Restrict)
  createdBy   User                  @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships CommunityMembership[]

  // ── Core ilişkileri (Faruk) — kaldırmayın ──
  polls Poll[]

  @@index([status, memberCount(sort: Desc)])
  @@map("communities")
}

// Katıl = satır ekle, ayrıl = satırı sil (join tablosu, DATA_MODEL §2.4).
// Bileşik PK tekrar katılmanın ikinci üyelik üretmesini engeller.
model CommunityMembership {
  communityId String        @map("community_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        CommunityRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId, createdAt(sort: Desc)])
  // Topluluğun moderatör listesi ve yetki kontrolü.
  @@index([communityId, role])
  @@map("community_memberships")
}
