// Sahip: Faruk (@farukkemree) — KV-02
// Hesap, kategori, anket, seçenek, oy ve yorum çekirdeği.
// Kurallar (ID, zaman, silme, kilitler, trigger'lar): docs/DATA_MODEL.md
// Prisma'nın ifade edemediği CHECK kısıtları ve trigger'lar migration SQL'inde elle yazılıdır.

enum UserStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED

  @@map("user_status")
}

enum ContentStatus {
  ACTIVE
  HIDDEN
  UNDER_REVIEW
  LOCKED
  REMOVED

  @@map("content_status")
}

// Gönderi türü (#66, V1_USER_FLOW): seçenekli anket veya seçeneksiz tartışma/soru gönderisi.
// Tür oluşturulduktan sonra değişmez (trigger). DISCUSSION'da seçenek, oy, süre ve sonuç görünürlüğü yoktur.
enum PollKind {
  POLL
  DISCUSSION

  @@map("poll_kind")
}

enum ResultsVisibility {
  ALWAYS
  AFTER_VOTE

  @@map("results_visibility")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_purpose")
}

enum CommentKind {
  COMMENT
  ALTERNATIVE

  @@map("comment_kind")
}

enum ReactionValue {
  LIKE
  DISLIKE

  @@map("reaction_value")
}

enum VoteEventType {
  CAST
  CHANGE
  INVALIDATE
  RESTORE

  @@map("vote_event_type")
}

// ─── Hesap ────────────────────────────────────────────────────

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String     @db.VarChar(254)
  emailNormalized    String     @unique @map("email_normalized") @db.VarChar(254)
  username           String     @db.VarChar(30)
  usernameNormalized String     @unique @map("username_normalized") @db.VarChar(30)
  displayName        String     @map("display_name") @db.VarChar(60)
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  bio                String?    @db.VarChar(300)
  avatarMediaId      String?    @map("avatar_media_id") @db.Uuid
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(3)

  avatarMedia      MediaAsset?       @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  sessions         Session[]
  authTokens       AuthToken[]
  idempotencyKeys  IdempotencyKey[]
  polls            Poll[]
  votes            Vote[]
  voteEvents       VoteEvent[]       @relation("VoteEventUser")
  // KV-43: yaptığı oy geçersiz sayma / geri alma işlemleri
  voteCorrections  VoteEvent[]       @relation("VoteEventActor")
  comments         Comment[]
  commentReactions CommentReaction[]
  pollReactions    PollReaction[]
  pollRevisions    PollRevision[]
  commentRevisions CommentRevision[]

  // Mert — media.prisma (KV-16)
  uploadedMedia            MediaAsset[]          @relation("MediaUploader")
  reviewedMedia            MediaAsset[]          @relation("MediaReviewer")
  // Mert — moderation.prisma (KV-24)
  reportsFiled             Report[]              @relation("ReportReporter")
  reportsAgainst           Report[]              @relation("ReportTargetUser")
  reportsResolved          Report[]              @relation("ReportResolver")
  moderationActionsTaken   ModerationAction[]    @relation("ModerationActor")
  moderationActionsAgainst ModerationAction[]    @relation("ModerationTargetUser")
  // Mert — community.prisma (KV-31)
  createdCommunities       Community[]           @relation("CommunityCreator")
  communityMemberships     CommunityMembership[]
  // Utku — admin.prisma (KV-12)
  role                     UserRole?             @relation("UserRoleHolder")
  rolesGranted             UserRole[]            @relation("UserRoleGranter")
  sanctions                Sanction[]            @relation("SanctionTarget")
  sanctionsIssued          Sanction[]            @relation("SanctionIssuer")
  sanctionsLifted          Sanction[]            @relation("SanctionLifter")
  // Mehmet — growth.prisma (KV-15/#17, V1 #67)
  interests                UserInterest[]
  pointAccount             PointAccount?
  pointLedgerEntries       PointLedgerEntry[]

  @@index([status])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // sha256(token + AUTH_TOKEN_PEPPER), hex
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ─── Kategori ve etiket ───────────────────────────────────────

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(60)
  description String?  @db.VarChar(300)
  iconKey     String?  @map("icon_key") @db.VarChar(60)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  polls     Poll[]
  interests UserInterest[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  polls PollTag[]

  @@map("tags")
}

model PollTag {
  pollId    String   @map("poll_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pollId, tagId])
  @@index([tagId])
  @@map("poll_tags")
}

// ─── Anket ────────────────────────────────────────────────────

model Poll {
  id                String             @id @default(uuid(7)) @db.Uuid
  // URL: /karar/<slug>-<publicId>
  publicId          String             @unique @map("public_id") @db.VarChar(12)
  slug              String             @db.VarChar(120)
  authorId          String             @map("author_id") @db.Uuid
  categoryId        String             @map("category_id") @db.Uuid
  communityId       String?            @map("community_id") @db.Uuid
  kind              PollKind           @default(POLL)
  title             String             @db.VarChar(200)
  description       String?
  priceAmount       Decimal?           @map("price_amount") @db.Decimal(14, 2)
  priceCurrency     String?            @map("price_currency") @db.Char(3)
  extraInfo         String?            @map("extra_info")
  status            ContentStatus      @default(ACTIVE)
  // DISCUSSION'da NULL (CHECK polls_kind_shape_check).
  resultsVisibility ResultsVisibility? @default(ALWAYS) @map("results_visibility")
  allowComments     Boolean            @default(true) @map("allow_comments")
  // Oylamanın başladığı an. Snapshot pencereleri buradan sayılır.
  opensAt           DateTime           @default(now()) @map("opens_at") @db.Timestamptz(3)
  // DISCUSSION'da NULL: tartışma süresizdir, kapanmaz (CHECK polls_kind_shape_check).
  closesAt          DateTime?          @map("closes_at") @db.Timestamptz(3)
  // Sahip/admin erken kapatırsa dolar. Etkin kapanış = LEAST(closes_at, closed_at).
  closedAt          DateTime?          @map("closed_at") @db.Timestamptz(3)
  // İlk geçerli oyda trigger doldurur; dolduktan sonra başlık, açıklama, seçenekler
  // ve sonuç görünürlüğü değiştirilemez (ek bilgi: PollAddendum) ve bu alan geri alınamaz.
  firstValidVoteAt  DateTime?          @map("first_valid_vote_at") @db.Timestamptz(3)
  // Doluysa anket algoritmik trend listelerine girmez (EXCLUDE_FROM_TRENDS moderasyon işlemi, KV-37 Mert yazar).
  // Görünürlüğü etkilemez; editör seçimi/öne çıkarma ayrı yüzeydir (KV-28, docs/KV-28_TRENDS.md).
  trendExcludedAt   DateTime?          @map("trend_excluded_at") @db.Timestamptz(3)
  // Oy geçersiz sayıldı/geri alındı (KV-43): bu andan sonraki günlük snapshot'lar yeniden üretilecek. Worker
  // (trends.refresh, snapshots.daily) yeniden üretip temizler. NULL: snapshot'lar güncel.
  snapshotsStaleSince DateTime?        @map("snapshots_stale_since") @db.Timestamptz(3)
  voteCount         Int                @default(0) @map("vote_count")
  commentCount      Int                @default(0) @map("comment_count")
  saveCount         Int                @default(0) @map("save_count")
  // Gönderi tepkileri (#66); poll_reactions ile aynı transaction'da güncellenir.
  likeCount         Int                @default(0) @map("like_count")
  dislikeCount      Int                @default(0) @map("dislike_count")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)

  author            User                @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  community         Community?          @relation(fields: [communityId], references: [id], onDelete: Restrict)
  options           PollOption[]
  reactions         PollReaction[]
  revisions         PollRevision[]
  tags              PollTag[]
  media             PollMedia[]
  addenda           PollAddendum[]
  votes             Vote[]
  voteEvents        VoteEvent[]
  comments          Comment[]
  dailySnapshots    PollDailySnapshot[]
  trendScores       TrendScore[]
  // Mert — moderation.prisma (KV-24)
  reports           Report[]
  moderationActions ModerationAction[]

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@index([communityId, status, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([status, voteCount(sort: Desc)])
  @@index([closesAt])
  // "Senin İçin" aday havuzu ve "Yeni" sekmesi: opens_at ↓, id ↓ (KV-27).
  @@index([opensAt(sort: Desc), id(sort: Desc)])
  @@map("polls")
}

model PollOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  // 0..5 → en fazla 6 seçenek (CHECK). En az 2 seçenek uygulamada doğrulanır.
  position  Int      @db.SmallInt
  label     String   @db.VarChar(120)
  // Sadece geçerli oylar; Poll.voteCount ile aynı transaction'da güncellenir.
  voteCount Int      @default(0) @map("vote_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  poll           Poll                      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes          Vote[]
  eventsFrom     VoteEvent[]               @relation("VoteEventFrom")
  eventsTo       VoteEvent[]               @relation("VoteEventTo")
  dailySnapshots PollOptionDailySnapshot[]

  @@unique([pollId, position])
  // Vote ve snapshot'taki bileşik FK'ler için: seçenek gerçekten o ankete ait olmalı.
  @@unique([pollId, id])
  @@map("poll_options")
}

// Sahibin ankete sonradan eklediği tarihli açıklama (KV-10). Asıl metin değişmez.
model PollAddendum {
  id        String   @id @default(uuid(7)) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Restrict)

  @@index([pollId, createdAt])
  @@map("poll_addenda")
}

// Anket galerisi: anket ↔ Mert'in MediaAsset tablosu.
model PollMedia {
  pollId    String   @map("poll_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([pollId, mediaId])
  @@unique([pollId, position])
  @@index([mediaId])
  @@map("poll_media")
}

// ─── Oy ───────────────────────────────────────────────────────

// Kullanıcının bir anketteki tek aktif oyu. Geçersiz sayılan oy satırı silinmez;
// invalidatedAt dolar, sayaçlardan düşülür ve aynı kullanıcı o ankete yeniden oy veremez.
model Vote {
  id                 String    @id @default(uuid(7)) @db.Uuid
  pollId             String    @map("poll_id") @db.Uuid
  optionId           String    @map("option_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  changeCount        Int       @default(0) @map("change_count")
  // KV-43: yetkili, gerekçeli geçersiz sayma. İkisi birlikte dolu ya da birlikte boş (CHECK).
  invalidatedAt      DateTime? @map("invalidated_at") @db.Timestamptz(3)
  invalidationReason String?   @map("invalidation_reason") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  poll   Poll        @relation(fields: [pollId], references: [id], onDelete: Restrict)
  option PollOption  @relation(fields: [pollId, optionId], references: [pollId, id], onDelete: Restrict)
  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  events VoteEvent[]

  // Tek aktif oy kuralı.
  @@unique([pollId, userId])
  @@index([pollId, optionId])
  // "Senin İçin" feed'i (KV-27): belli bir ana kadar ve son 24 saatteki geçerli oy sayısı.
  // invalidated_at index'te olduğu için sayım tabloya gitmeden (index-only) yapılır.
  @@index([pollId, createdAt, invalidatedAt])
  @@index([userId, createdAt(sort: Desc)])
  // Trend pencereleri (KV-28): son 24 saat / 7 günde verilen oylar.
  @@index([createdAt])
  @@map("votes")
}

// Append-only oy geçmişi (UPDATE/DELETE trigger ile engellenir).
// Snapshot ve Haftanın Değişkenleri bu tablodan geriye dönük hesaplanır.
model VoteEvent {
  id           String        @id @default(uuid(7)) @db.Uuid
  voteId       String        @map("vote_id") @db.Uuid
  pollId       String        @map("poll_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  type         VoteEventType
  fromOptionId String?       @map("from_option_id") @db.Uuid
  toOptionId   String?       @map("to_option_id") @db.Uuid
  reason       String?       @db.VarChar(500)
  // INVALIDATE/RESTORE'u yapan yönetici (KV-43); audit tablosu (KV-39) gelene kadar "kim yaptı" izi burada.
  // CHECK vote_events_actor_check: INVALIDATE/RESTORE'da aktör ve gerekçe zorunlu; CAST/CHANGE'de aktör yok.
  actorId      String?       @map("actor_id") @db.Uuid
  occurredAt   DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)

  vote       Vote        @relation(fields: [voteId], references: [id], onDelete: Restrict)
  poll       Poll        @relation(fields: [pollId], references: [id], onDelete: Restrict)
  user       User        @relation("VoteEventUser", fields: [userId], references: [id], onDelete: Restrict)
  actor      User?       @relation("VoteEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromOption PollOption? @relation("VoteEventFrom", fields: [fromOptionId], references: [id], onDelete: Restrict)
  toOption   PollOption? @relation("VoteEventTo", fields: [toOptionId], references: [id], onDelete: Restrict)

  @@index([pollId, occurredAt])
  @@index([voteId, occurredAt])
  @@index([userId, occurredAt])
  @@map("vote_events")
}

// ─── Yorum ve alternatif öneri ────────────────────────────────

// Tek seviye cevap: cevabın cevabı trigger ile engellenir.
// ALTERNATIVE sadece üst seviyede olabilir (CHECK).
model Comment {
  id           String        @id @default(uuid(7)) @db.Uuid
  pollId       String        @map("poll_id") @db.Uuid
  authorId     String        @map("author_id") @db.Uuid
  parentId     String?       @map("parent_id") @db.Uuid
  kind         CommentKind   @default(COMMENT)
  body         String
  status       ContentStatus @default(ACTIVE)
  likeCount    Int           @default(0) @map("like_count")
  // Tepki sayaçları comment_reactions ile aynı transaction'da güncellenir (KV-17).
  dislikeCount Int           @default(0) @map("dislike_count")
  replyCount   Int           @default(0) @map("reply_count")
  editedAt     DateTime?     @map("edited_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(3)

  poll              Poll               @relation(fields: [pollId], references: [id], onDelete: Restrict)
  author            User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  // Bileşik FK: cevap, ebeveyniyle aynı ankette olmak zorunda.
  revisions         CommentRevision[]
  parent            Comment?           @relation("CommentReplies", fields: [pollId, parentId], references: [pollId, id], onDelete: Restrict)
  replies           Comment[]          @relation("CommentReplies")
  reactions         CommentReaction[]
  // Mert — moderation.prisma (KV-24)
  reports           Report[]
  moderationActions ModerationAction[]

  @@unique([pollId, id])
  @@index([pollId, parentId, createdAt])
  @@index([pollId, kind, likeCount(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  // Trend pencereleri (KV-28): son 24 saat / 7 günde yazılan yorumlar.
  @@index([createdAt])
  @@map("comments")
}

// Yorum tepkisi (beğeni/dislike) — KV-17 (#19). comment_likes'ın yerine geçer (API_CONTRACTS §6).
// Kullanıcı + yorum başına tek aktif tepki; değiştirme satırı günceller, kaldırma siler.
// Anket tepkileri (#66) aynı ReactionValue enum'unu kullanır.
// Gönderi (anket veya tartışma) beğeni/dislike'ı (#66). Anket oyundan ayrıdır. Hesap + gönderi başına tek aktif tepki.
model PollReaction {
  pollId    String        @map("poll_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  value     ReactionValue
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
  @@map("poll_reactions")
}

// İçerik sürüm geçmişi (#66, V1_USER_FLOW "Kullanıcı ve admin logları"): her oluşturma ve düzenlemede içeriğin
// o anki hali yeni sürüm olarak yazılır. Sürüm 1 ilk paylaşımdır. Append-only (trigger). Okuma yalnız ADMIN+
// (admin.revisions.polls). Operasyon loglarında içerik değil, sadece bu kayda referans tutulur.
model PollRevision {
  id       String   @id @default(uuid(7)) @db.Uuid
  pollId   String   @map("poll_id") @db.Uuid
  version  Int
  editorId String   @map("editor_id") @db.Uuid
  editedAt DateTime @map("edited_at") @db.Timestamptz(3)
  snapshot Json

  poll   Poll @relation(fields: [pollId], references: [id], onDelete: Restrict)
  editor User @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([pollId, version])
  @@map("poll_revisions")
}

model CommentRevision {
  id        String   @id @default(uuid(7)) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  version   Int
  editorId  String   @map("editor_id") @db.Uuid
  editedAt  DateTime @map("edited_at") @db.Timestamptz(3)
  snapshot  Json

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Restrict)
  editor  User    @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([commentId, version])
  @@map("comment_revisions")
}

model CommentReaction {
  commentId String        @map("comment_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  value     ReactionValue
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_reactions")
}

// ─── Idempotency ──────────────────────────────────────────────
// Idempotency-Key kayıtları (API_CONTRACTS.md §4.5). Kapsam: kullanıcı + route + anahtar.
// Satır, işlemle aynı transaction'da ilk adım olarak eklenir: aynı anahtarla gelen eşzamanlı
// istek unique index'te bekler, ilki commit edince çakışma alır ve kaydedilen sonucu döner.
// Süresi dolan satır yok sayılır; temizliği bir worker job'u yapar.
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  route          String   @db.VarChar(80)
  key            String   @db.VarChar(128)
  // sha256(doğrulanmış istek gövdesi), hex. Aynı anahtar + farklı gövde → 409.
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status") @db.SmallInt
  // Oluşturulan kaynağın id'si; tekrar isteğinde cevap bu kaynaktan yeniden üretilir.
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
