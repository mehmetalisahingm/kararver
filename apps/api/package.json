{
  "name": "@kararver/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "start:cluster": "node src/cluster.ts",
    "perf:seed": "node perf/seed.ts",
    "perf:load": "node perf/load.ts",
    "perf:queries": "node perf/query-count.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "admin:bootstrap": "node src/modules/rbac/bootstrap-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@kararver/contracts": "workspace:*",
    "@kararver/db": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "fastify": "5.12.5",
    "nodemailer": "10.0.13",
    "pg-boss": "12.35.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  }
}
