# Copy to apps/web/.env.local. Public values are fixed when Next builds.
NEXT_PUBLIC_KV_DATA_MODE=api
# Origin only, or origin + /v1. Use the same hostname as WEB_URL (cookie/CORS).
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# Backend must use WEB_URL=http://127.0.0.1:3000 for the default web dev command.
