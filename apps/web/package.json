{
  "name": "@kararver/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-assets.mjs && node scripts/build-cabin.mjs && next dev --hostname 127.0.0.1",
    "dev:demo": "node scripts/serve-demo.mjs",
    "build": "node scripts/sync-assets.mjs && node scripts/build-cabin.mjs && next build",
    "build:cabin": "node scripts/build-cabin.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kararver/contracts": "workspace:*",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "three": "0.187.0",
    "typescript": "6.0.3"
  }
}
