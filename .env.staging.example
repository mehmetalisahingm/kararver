# ─────────────────────────────────────────────────────────────
# KararVer — STAGING ortamı için değişken listesi
# Bu dosya sadece HANGİ değişkenlerin gerektiğini gösterir.
# Değerler repoya yazılmaz; hosting panelindeki (Railway/Vercel)
# environment variables bölümüne girilir. Boş bırakılanlar zorunludur.
# ─────────────────────────────────────────────────────────────

APP_ENV=staging
NODE_ENV=production
APP_TIMEZONE=Europe/Istanbul
LOG_LEVEL=info

WEB_URL=
API_URL=
NEXT_PUBLIC_API_URL=

# Railway PostgreSQL servisinin bağlantı adresi (panelden referans verilir)
DATABASE_URL=

SESSION_COOKIE_NAME=kv_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
# Her ortamda farklı, 32+ byte rastgele değer. Production ile paylaşılmaz.
AUTH_TOKEN_PEPPER=

# Sağlayıcıdan bağımsız SMTP (TECH_DECISIONS §10 #2). Sağlayıcının SMTP bilgisi tek adreste:
#   smtp://KULLANICI:PAROLA@HOST:587  (STARTTLS zorunlu; sunucu sunmazsa gönderim yapılmaz)
#   smtps://KULLANICI:PAROLA@HOST:465 (doğrudan TLS)
# Kullanıcı/parolada @ : / # gibi karakterler yüzde-kodlanır. TLS'i kapatan parametreler reddedilir.
# MAIL_FROM sağlayıcıda doğrulanmış (SPF/DKIM) alan adından olmalı, ör. "KararVer <no-reply@alanadi>".
MAIL_TRANSPORT=smtp
MAIL_FROM=
SMTP_URL=

# Cloudflare R2 (staging'e ayrılmış bucket'lar ve API token'ı)
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=kararver-staging-uploads-private
S3_BUCKET_PUBLIC=kararver-staging-media-public
MEDIA_PUBLIC_BASE_URL=

JOBS_ENABLED=true
# Görsel moderasyonu (apps/worker, docs/MEDIA_MODERATION.md §4). Yorumlayıcıda
# apps/worker/python/requirements.txt kurulu olmalı. Eşzamanlı işlenen görsel sayısı:
MODERATION_PYTHON=python3
MEDIA_WORKER_CONCURRENCY=1
TREND_REFRESH_CRON="*/5 * * * *"
DAILY_SNAPSHOT_CRON="5 0 * * *"
